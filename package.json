{
	"name": "gif-to-spritesheet",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Convert GIF animations to spritesheets + TexturePacker-style JSON — built with Vue 3, Vite, TypeScript and Tailwind CSS.",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"vue": "^3.5.42"
	},
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.12.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.9.1",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^15.15.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vue-tsc": "^3.3.11"
	}
}
